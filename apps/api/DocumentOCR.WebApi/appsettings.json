{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    // Allowed origins for the production CORS policy. Empty by default: no
    // cross-origin requests are permitted until an environment-specific
    // config (e.g. appsettings.Production.json or an env var) sets this to
    // the real frontend origin(s).
    "AllowedOrigins": []
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=document_ocr;Username=postgres;Password=d0cument0cr2026"
  },

  "Storage": {
    "BasePath": "C:\\DocumentOCR\\uploads"
  },

  "Credits": {
    // Master switch for the whole credit-charging layer. Default false so local development
    // never blocks on credit balance — TryConsumeAsync always succeeds and writes no ledger row
    // while this is off. Set true to enforce prepaid balances (production).
    "Enabled": false,
    // Prepaid-credit pricing per processing attempt and the per-organization daily spend cap.
    // XmlParse/PdfTextLayer are 0 because those paths cost nothing to run (direct XML parse /
    // reading a PDF's own embedded text layer, no external OCR call) — priced at marginal cost.
    "XmlParse": 0,
    "PdfTextLayer": 0,
    "OcrExtraction": 2,
    "MaxDailyConsumePerOrg": 1000
  },

  "Ocr": {
    // Which IDocumentOcrProvider to register: "Fake" (default, no cloud dependency) or "Azure".
    "Provider": "Fake",
    // Persist OcrResult.RawProviderResponseJson into OcrProviderLog.RawResponseJson for debugging.
    "StoreRawProviderResponse": true,
    // Hard ceiling on a single OCR provider call, enforced by DocumentProcessingService itself
    // (independent of any timeout the provider enforces internally) — a provider that hangs marks
    // the document Failed instead of leaving it stuck in Processing forever.
    "CallTimeoutSeconds": 120,
    "PdfTextLayer": {
      // Software-generated PDFs (e-invoices from MISA/Viettel/VNPT/BKAV, ...) already carry an
      // accurate text layer -- when true (default), PdfProviderRouter reads it directly via
      // PdfTextLayerProvider instead of running OCR, and only falls back to the configured OCR
      // provider when the PDF turns out to be a scan. Set false to force every PDF through OCR
      // (e.g. to compare extraction quality between the two paths).
      "Enabled": true,
      // Minimum total extracted character count below which a PDF is treated as scanned.
      "MinExtractedCharacters": 100
    }
  },

  "OcrDebug": {
    // Gates GET /api/documents/{id}/review's DebugData summary and the whole
    // GET /api/documents/{id}/ocr-debug endpoint. Off by default in production.
    "Enabled": false,
    // Whether the ocr-debug endpoint may include the raw provider response JSON content
    // (not just its storage path). Never enable in production.
    "ExposeRawJson": false
  },

  // Endpoint/ApiKey are intentionally blank here — never put real credentials in a committed
  // appsettings*.json file. Set them via `dotnet user-secrets` (local dev) or the
  // AzureDocumentIntelligence__Endpoint / AzureDocumentIntelligence__ApiKey env vars
  // (CI/containers/production). See LOCAL_DEVELOPMENT.md.
  "AzureDocumentIntelligence": {
    "Endpoint": "",
    "ApiKey": "",
    "DefaultModelId": "prebuilt-layout",
    // Add-on features requested on every analyze call. "keyValuePairs" improves extraction of
    // label/value pairs on Vietnamese invoices and receipts when the model supports it.
    "Features": [
      "keyValuePairs"
    ],
    // Model IDs the dev-only OCR benchmark tool (apps/api/tools/DocumentOCR.OcrBenchmark) runs
    // per sample file by default. Not used by the WebApi request pipeline itself.
    "BenchmarkModelIds": [
      "prebuilt-read",
      "prebuilt-layout",
      "prebuilt-invoice",
      "prebuilt-receipt"
    ],
    "NetworkTimeoutSeconds": 30,
    "OperationTimeoutSeconds": 120,
    "MaxRetries": 3,
    "RetryDelaySeconds": 1.0
  }
}

